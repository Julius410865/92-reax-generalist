 "types_dropped_not_separable": {
  "Heat": {
   "reason": "told apart from Excessive Heat only by local warning thresholds; once heat words are removed both are temperature reports (or heat-death reports with no cue left)",
   "records": 7468
  },
  "Cold/Wind Chill": {
   "reason": "told apart from Extreme Cold/Wind Chill only by local warning thresholds; both read as low temperature reports once cold / wind-chill words are removed",
   "records": 2929
  },
  "Strong Wind": {
   "reason": "told apart from High Wind only by the measured speed, which is in the removed wind / gust / mph sentences; the rest is the same tree and power-line damage",
   "records": 2903
  },
  "Heavy Snow": {
   "reason": "told apart from Winter Storm only by whether other hazards (sleet, ice, wind) occurred, which are removed words; both read as snowfall-amount reports",
   "records": 5029
  },
  "Blizzard": {
   "reason": "defined by wind, blowing snow and visibility together; with those words removed it reads as Winter Weather / Winter Storm",
   "records": 1265
  },
  "Marine Thunderstorm Wind": {
   "reason": "the narratives are wind-gust measurements; few records keep any text without the type's own words",
   "records": 6299
  },
  "Funnel Cloud": {
   "reason": "the narratives only say that a funnel was seen; almost nothing is left without the type's own words",
   "records": 555
  },
  "Lightning": {
   "reason": "what is left without lightning / thunderstorm words is a fire or an injury with no cue to the type",
   "records": 568
  },
  "Coastal Flood": {
   "reason": "with tide / coastal / flood words removed it reads as Flood (water on roads)",
   "records": 693
  },
  "Heavy Rain": {
   "reason": "with rain words removed what is left is an amount in inches (read as snowfall) or water, rock and mud on roads (read as Flood / Flash Flood)",
   "records": 1668
  }
 },
